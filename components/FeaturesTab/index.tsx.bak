"use client";
import Image from "next/image";
import { useState, useRef, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { useEtudiantStore } from "../../store/etudiantStore";
import { useSectionStore } from "../../store/sectionStore";
import { ModalResultat } from "../Common/ModalResultat";

const FeaturesTab = () => {
  const {
    formData,
    isSubmitting,
    error,
    updateFormData,
    submitInscription,
    setError,
    resetForm,
  } = useEtudiantStore();

  const { section, fetchSection } = useSectionStore();

  const [uploadProgress, setUploadProgress] = useState<{[key: string]: number}>({});
  const fileInputRef = useRef<HTMLInputElement>(null);
  const photoInputRef = useRef<HTMLInputElement>(null);

  // États pour la modal de résultats
  const [showModal, setShowModal] = useState(false);
  const [registrationResult, setRegistrationResult] = useState<{
    etudiant: any;
    section: any;
  } | null>(null);

  // Charger les sections au démarrage
  useEffect(() => {
    if (!section) {
      fetchSection();
    }
  }, [section, fetchSection]);

  const handleFileUpload = (files: FileList | null, type: 'photo' | 'documents') => {
    if (!files) return;

    if (type === 'photo' && files[0]) {
      updateFormData({ photo: files[0] });
    } else if (type === 'documents') {
      const newDocs = Array.from(files);
      updateFormData({ 
        documents: [...formData.documents, ...newDocs] 
      });
    }
  };

  const removeDocument = (index: number) => {
    const newDocs = formData.documents.filter((_, i) => i !== index);
    updateFormData({ documents: newDocs });
  };

  const nextStep = () => {
    if (currentStep < 3) {
      setCurrentStep(currentStep + 1);
      setError(null);
    }
  };

  const prevStep = () => {
    if (currentStep > 1) {
      setCurrentStep(currentStep - 1);
      setError(null);
    }
  };

  const handleSubmit = async () => {
    try {
      const nouveauEtudiant = await submitInscription();
      
      if (nouveauEtudiant) {
        console.log('Inscription réussie pour:', nouveauEtudiant.matricule);
        console.log('Section trouvée:', section);
        
        // Afficher la modal avec les résultats
        setRegistrationResult({
          etudiant: nouveauEtudiant,
          section: section
        });
        setShowModal(true);
      }
    } catch (err) {
      console.error('Erreur inscription:', err);
    }
  };

  const isStepValid = (step: number) => {
    switch (step) {
      case 1:
        return formData.nom && formData.post_nom && formData.prenom && 
               formData.sexe && formData.nationalite;
      case 2:
        return formData.lieu_naissance && formData.date_naissance && 
               formData.secure && formData.confirmPassword &&
               formData.secure === formData.confirmPassword;
      case 3:
        return formData.documents.length > 0;
      default:
        return false;
    }
  };

  const stepTitles = [
    "Identité",
    "Informations",
    "Documents"
  ];

  return (
    <>
      {/* <!-- ===== Inscription Étudiant Start ===== --> */}
      <section className="relative pb-20 pt-18.5 lg:pb-22.5">
        <div className="relative mx-auto max-w-c-1390 px-4 md:px-8 2xl:px-0">
          <div className="absolute -top-16 -z-1 mx-auto h-[350px] w-[90%]">
            <Image
              fill
              className="dark:hidden"
              src="/images/shape/shape-dotted-light.svg"
              alt="Dotted Shape"
            />
            <Image
              fill
              className="hidden dark:block"
              src="/images/shape/shape-dotted-dark.svg"
              alt="Dotted Shape"
            />
          </div>

          {/* Header */}
          <motion.div
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            className="text-center mb-12"
          >
            <h2 className="text-3xl font-bold text-black dark:text-white lg:text-4xl xl:text-5xl">
              Inscription Étudiant
            </h2>
            <p className="text-lg text-body-color dark:text-bodydark mt-4">
              Rejoignez notre communauté académique en quelques étapes simples
            </p>
          </motion.div>

          {/* Progress Steps */}
          <motion.div
            variants={{
              hidden: { opacity: 0, y: -20 },
              visible: { opacity: 1, y: 0 },
            }}
            initial="hidden"
            whileInView="visible"
            transition={{ duration: 0.5, delay: 0.1 }}
            viewport={{ once: true }}
            className="animate_top mb-15 flex flex-wrap justify-center rounded-[10px] border border-stroke bg-white shadow-solid-5 dark:border-strokedark dark:bg-blacksection dark:shadow-solid-6 md:flex-nowrap md:items-center lg:gap-7.5 xl:mb-21.5 xl:gap-12.5"
          >
            {[1, 2, 3].map((step) => (
              <div
                key={step}
                onClick={() => currentStep > step && setCurrentStep(step)}
                className={`relative flex w-full cursor-pointer items-center gap-4 border-b border-stroke px-6 py-2 last:border-0 dark:border-strokedark md:w-auto md:border-0 xl:px-13.5 xl:py-5 ${
                  currentStep === step
                    ? "active before:absolute before:bottom-0 before:left-0 before:h-1 before:w-full before:rounded-tl-[4px] before:rounded-tr-[4px] before:bg-primary"
                    : ""
                } ${currentStep > step ? "opacity-75 hover:opacity-100" : ""}`}
              >
                <div className={`flex h-12.5 w-12.5 items-center justify-center rounded-[50%] border ${
                  currentStep >= step && isStepValid(step)
                    ? "border-primary bg-primary text-white" 
                    : "border-stroke dark:border-strokedark dark:bg-blacksection"
                }`}>
                  <p className="text-metatitle3 font-medium">
                    {currentStep > step && isStepValid(step) ? "✓" : `0${step}`}
                  </p>
                </div>
                <div className="md:w-3/5 lg:w-auto">
                  <button className="text-sm font-medium text-black dark:text-white xl:text-regular">
                    {stepTitles[step - 1]}
                  </button>
                </div>
              </div>
            ))}
          </motion.div>

          {/* Form Content */}
          <motion.div
            variants={{
              hidden: { opacity: 0, y: -20 },
              visible: { opacity: 1, y: 0 },
            }}
            initial="hidden"
            whileInView="visible"
            transition={{ duration: 0.5, delay: 0.5 }}
            viewport={{ once: true }}
            className="animate_top mx-auto max-w-c-1154"
          >
            <div className="rounded-lg border border-stroke bg-white p-8 shadow-solid-8 dark:border-strokedark dark:bg-blacksection">
              <AnimatePresence mode="wait">
                {/* Étape 1: Identité */}
                {currentStep === 1 && (
                  <motion.div
                    key="step1"
                    initial={{ opacity: 0, x: 50 }}
                    animate={{ opacity: 1, x: 0 }}
                    exit={{ opacity: 0, x: -50 }}
                    transition={{ duration: 0.3 }}
                    className="space-y-6"
                  >
                    <h3 className="text-2xl font-bold text-black dark:text-white mb-6">
                      Informations d'identité
                    </h3>
                    
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Nom *
                        </label>
                        <input
                          type="text"
                          value={formData.nom}
                          onChange={(e) => updateFormData({ nom: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                          placeholder="Entrez votre nom"
                        />
                      </div>
                      
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Post-nom *
                        </label>
                        <input
                          type="text"
                          value={formData.post_nom}
                          onChange={(e) => updateFormData({ post_nom: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                          placeholder="Entrez votre post-nom"
                        />
                      </div>
                      
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Prénom *
                        </label>
                        <input
                          type="text"
                          value={formData.prenom}
                          onChange={(e) => updateFormData({ prenom: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                          placeholder="Entrez votre prénom"
                        />
                      </div>
                      
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Sexe *
                        </label>
                        <select
                          value={formData.sexe}
                          onChange={(e) => updateFormData({ sexe: e.target.value as 'M' | 'F' })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                        >
                          <option value="">Sélectionnez</option>
                          <option value="M">Masculin</option>
                          <option value="F">Féminin</option>
                        </select>
                      </div>
                      
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Nationalité *
                        </label>
                        <input
                          type="text"
                          value={formData.nationalite}
                          onChange={(e) => updateFormData({ nationalite: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                          placeholder="Ex: Congolaise"
                        />
                      </div>
                    </div>
                  </motion.div>
                )}

                {/* Étape 2: Informations */}
                {currentStep === 2 && (
                  <motion.div
                    key="step2"
                    initial={{ opacity: 0, x: 50 }}
                    animate={{ opacity: 1, x: 0 }}
                    exit={{ opacity: 0, x: -50 }}
                    transition={{ duration: 0.3 }}
                    className="space-y-6"
                  >
                    <h3 className="text-2xl font-bold text-black dark:text-white mb-6">
                      Informations complémentaires
                    </h3>
                    
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Lieu de naissance *
                        </label>
                        <input
                          type="text"
                          value={formData.lieu_naissance}
                          onChange={(e) => updateFormData({ lieu_naissance: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                          placeholder="Ex: Kinshasa"
                        />
                      </div>
                      
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Date de naissance *
                        </label>
                        <input
                          type="date"
                          value={formData.date_naissance}
                          onChange={(e) => updateFormData({ date_naissance: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                        />
                      </div>
                      
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Mot de passe *
                        </label>
                        <input
                          type="password"
                          value={formData.secure}
                          onChange={(e) => updateFormData({ secure: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                          placeholder="Minimum 6 caractères"
                        />
                      </div>
                      
                      <div>
                        <label className="block text-sm font-medium text-black dark:text-white mb-2">
                          Confirmer le mot de passe *
                        </label>
                        <input
                          type="password"
                          value={formData.confirmPassword}
                          onChange={(e) => updateFormData({ confirmPassword: e.target.value })}
                          className="w-full rounded-lg border border-stroke bg-transparent px-4 py-3 text-black outline-none focus:border-primary dark:border-strokedark dark:text-white"
                          placeholder="Répétez le mot de passe"
                        />
                        {formData.secure && formData.confirmPassword && formData.secure !== formData.confirmPassword && (
                          <p className="text-red-500 text-sm mt-1">Les mots de passe ne correspondent pas</p>
                        )}
                      </div>
                    </div>
                    
                    {/* Photo Upload */}
                    <div>
                      <label className="block text-sm font-medium text-black dark:text-white mb-2">
                        Photo de profil (optionnel)
                      </label>
                      <div className="flex items-center space-x-4">
                        <input
                          type="file"
                          ref={photoInputRef}
                          accept="image/*"
                          onChange={(e) => handleFileUpload(e.target.files, 'photo')}
                          className="hidden"
                        />
                        <button
                          type="button"
                          onClick={() => photoInputRef.current?.click()}
                          className="rounded-lg border border-stroke bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors"
                        >
                          Choisir une photo
                        </button>
                        {formData.photo && (
                          <span className="text-sm text-black dark:text-white">
                            {formData.photo.name}
                          </span>
                        )}
                      </div>
                    </div>
                  </motion.div>
                )}

                {/* Étape 3: Documents */}
                {currentStep === 3 && (
                  <motion.div
                    key="step3"
                    initial={{ opacity: 0, x: 50 }}
                    animate={{ opacity: 1, x: 0 }}
                    exit={{ opacity: 0, x: -50 }}
                    transition={{ duration: 0.3 }}
                    className="space-y-6"
                  >
                    <h3 className="text-2xl font-bold text-black dark:text-white mb-6">
                      Documents académiques
                    </h3>
                    
                    <div>
                      <label className="block text-sm font-medium text-black dark:text-white mb-2">
                        Télécharger vos documents *
                      </label>
                      <p className="text-sm text-body-color dark:text-bodydark mb-4">
                        Diplômes, relevés de notes, certificats, etc. (PDF, JPG, PNG)
                      </p>
                      
                      <input
                        type="file"
                        ref={fileInputRef}
                        multiple
                        accept=".pdf,.jpg,.jpeg,.png"
                        onChange={(e) => handleFileUpload(e.target.files, 'documents')}
                        className="hidden"
                      />
                      
                      <button
                        type="button"
                        onClick={() => fileInputRef.current?.click()}
                        className="rounded-lg border-2 border-dashed border-stroke bg-gray-50 px-6 py-8 text-center hover:border-primary hover:bg-primary/5 transition-colors dark:border-strokedark dark:bg-blacksection w-full"
                      >
                        <div className="flex flex-col items-center space-y-2">
                          <svg className="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                          </svg>
                          <span className="text-black dark:text-white font-medium">
                            Cliquez pour ajouter des documents
                          </span>
                          <span className="text-sm text-body-color dark:text-bodydark">
                            ou glissez-déposez vos fichiers ici
                          </span>
                        </div>
                      </button>
                      
                      {/* Liste des documents */}
                      {formData.documents.length > 0 && (
                        <div className="mt-4 space-y-2">
                          <h4 className="font-medium text-black dark:text-white">Documents ajoutés:</h4>
                          {formData.documents.map((doc, index) => (
                            <div key={index} className="flex items-center justify-between p-3 bg-gray-50 dark:bg-blacksection rounded-lg">
                              <span className="text-sm text-black dark:text-white">{doc.name}</span>
                              <button
                                onClick={() => removeDocument(index)}
                                className="text-red-500 hover:text-red-700 text-sm"
                              >
                                Supprimer
                              </button>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>

              {/* Error Message */}
              {error && (
                <motion.div
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  className="mt-4 p-4 bg-red-50 border border-red-200 rounded-lg"
                >
                  <p className="text-red-600 text-sm">{error}</p>
                </motion.div>
              )}

              {/* Navigation Buttons */}
              <div className="flex justify-between mt-8">
                <button
                  onClick={prevStep}
                  disabled={currentStep === 1}
                  className="px-6 py-3 rounded-lg border border-stroke text-black hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed dark:border-strokedark dark:text-white dark:hover:bg-blacksection"
                >
                  Précédent
                </button>
                
                {currentStep < 3 ? (
                  <button
                    onClick={nextStep}
                    disabled={!isStepValid(currentStep)}
                    className="px-6 py-3 rounded-lg bg-primary text-white hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    Suivant
                  </button>
                ) : (
                  <button
                    onClick={handleSubmit}
                    disabled={!isStepValid(3) || isSubmitting}
                    className="px-6 py-3 rounded-lg bg-primary text-white hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    {isSubmitting ? 'Inscription en cours...' : 'S\'inscrire'}
                  </button>
                )}
              </div>
            </div>
          </motion.div>
        </div>
      </section>
      {/* <!-- ===== Inscription Étudiant End ===== --> */}

      {/* Modal de résultats */}
      {registrationResult && (
        <ModalResultat
          isOpen={showModal}
          onClose={() => {
            setShowModal(false);
            setRegistrationResult(null);
            resetForm(); // Réinitialiser le formulaire
          }}
          etudiant={registrationResult.etudiant}
          section={registrationResult.section}
        />
      )}
    </>
  );
};

export default FeaturesTab;
